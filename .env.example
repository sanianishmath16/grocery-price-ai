# ─── GroceryAI — Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit real secrets.
#
#   cp .env.example .env

# ── Redis ─────────────────────────────────────────────────────────────────────
# Default works with docker-compose (Redis container is named "redis")
REDIS_URL=redis://redis:6379/0

# ── OpenAI Vision API (optional) ──────────────────────────────────────────────
# Required to enable the "Search by Image" product detection feature.
# Get your key at https://platform.openai.com/api-keys
# Leave blank to run without image recognition (text search still works).
OPENAI_API_KEY=

# ── CORS (optional) ───────────────────────────────────────────────────────────
# In development "*" is fine. In production, list your domain(s):
#   CORS_ORIGINS=https://groceryai.onrender.com,https://www.groceryai.com
CORS_ORIGINS=*
